<Window x:Class="Steps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ahir Setup Wizard"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    <Border CornerRadius="12" Background="#1e1e2e" BorderBrush="#2a2a3e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border Grid.Column="0" Background="#16162a" CornerRadius="12,0,0,12">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,8,0,24">
                        <TextBlock Text="Ahır" FontSize="28" FontWeight="Bold" Foreground="#7c6ff0"/>
                        <TextBlock Text="Setup Wizard" FontSize="13" Foreground="#8888aa" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" x:Name="StepList">
                        <TextBlock Text="Welcome" x:Name="Step1" Margin="0,0,0,12" FontSize="14" Foreground="#7c6ff0" FontWeight="SemiBold"/>
                        <TextBlock Text="System Check" x:Name="Step2" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Location" x:Name="Step3" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Server Config" x:Name="Step4" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Security" x:Name="Step5" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Summary" x:Name="Step6" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Install" x:Name="Step7" Margin="0,0,0,12" FontSize="14" Foreground="#555577"/>
                        <TextBlock Text="Complete" x:Name="Step8" FontSize="14" Foreground="#555577"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="v1.0.0" FontSize="11" Foreground="#444466"/>
                </Grid>
            </Border>

            <!-- Right content area -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageContent" Grid.Row="0"/>

                <Border Grid.Row="1" Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton" Grid.Column="1" Content="Back"
                                Width="80" Height="32" Margin="0,0,8,0"
                                Background="#2a2a3e" Foreground="#ccc"
                                BorderThickness="0"
                                Cursor="Hand" Click="BackButton_Click"
                                FontSize="13" IsEnabled="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="Button.DisabledBackground" Color="#1a1a2e"/>
                                <SolidColorBrush x:Key="Button.DisabledForeground" Color="#444466"/>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="NextButton" Grid.Column="2" Content="Next"
                                Width="80" Height="32"
                                Background="#7c6ff0" Foreground="#fff"
                                BorderThickness="0"
                                Cursor="Hand" Click="NextButton_Click"
                                FontSize="13"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Close button -->
            <Button Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Background="Transparent" Foreground="#666"
                    BorderThickness="0" FontSize="16"
                    Cursor="Hand" Click="CloseButton_Click"
                    Content="✕"/>
        </Grid>
    </Border>
</Window>